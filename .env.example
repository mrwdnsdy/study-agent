# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Models. By default the study guide is written by claude-opus-5 and chat, quizzes,
# grading and reviews run on claude-sonnet-5. ANTHROPIC_MODEL applies to every task
# unless a per-task variable overrides it.
#ANTHROPIC_MODEL=
#ANTHROPIC_MODEL_GUIDE=claude-opus-5
#ANTHROPIC_MODEL_CHAT=claude-sonnet-5
#ANTHROPIC_MODEL_QUIZ=claude-sonnet-5
#ANTHROPIC_MODEL_GRADING=claude-sonnet-5
#ANTHROPIC_MODEL_REVIEW=claude-sonnet-5
# Used for "Maximum quality" guides and whenever a task's model declines or returns
# nothing. About twice the price of Opus. Set to "off" to disable.
#ANTHROPIC_ESCALATION_MODEL=claude-fable-5-1

# Persona name of the study agent (shown in the app and used in the prompts).
AGENT_NAME=Kiiku

# Server port (the Vite dev server proxies /api to this port)
PORT=3001

# Where sessions, uploads and generated content are stored
DATA_DIR=./data

# Max total upload size per request, in MB
MAX_UPLOAD_MB=100

# Optional: path to LibreOffice's soffice binary. When available, PPTX/DOCX are
# converted to PDF so Claude sees every slide exactly as rendered.
# Leave blank to auto-detect on PATH; set to "off" to disable.
SOFFICE_PATH=

# Optional: Google OAuth Web client ID for "Open in Google Docs" export.
# Create one at https://console.cloud.google.com/apis/credentials (enable the Drive API,
# add your app origin e.g. http://localhost:5173 to Authorized JavaScript origins).
VITE_GOOGLE_CLIENT_ID=

# Build-time flags for the static GitHub Pages bundle (see README "Share it as a web page").
# VITE_BROWSER_MODE=true builds without a server (visitors enter a key in Settings);
# VITE_BASE=/study-agent/ sets the public path of a project site.
#VITE_BROWSER_MODE=true
#VITE_BASE=/study-agent/
